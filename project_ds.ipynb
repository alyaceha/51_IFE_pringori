    "# Analisis kesalahan: kamera mana yang paling meleset diprediksi (data test)\n",
    "analisis = pd.DataFrame({\n",
    "    'Model Kamera': df_raw.loc[y_test.index, 'Model'],\n",
    "    'Weight (g)': X_test['Weight (inc. batteries)'],\n",
    "    'Harga Aktual': y_test,\n",
    "    'Harga Prediksi': y_pred_final,\n",
    "}, index=y_test.index)\n",
    "analisis['Selisih (Prediksi - Aktual)'] = analisis['Harga Prediksi'] - analisis['Harga Aktual']\n",
    "analisis['Error Absolut'] = analisis['Selisih (Prediksi - Aktual)'].abs()\n",
    "\n",
    "top_err = analisis.sort_values('Error Absolut', ascending=False).head(5)\n",
    "print(\"5 KESALAHAN TERBESAR PADA DATA TEST\")\n",
    "display(top_err.round(2))\n",
    "\n",
    "# Contoh kesalahan terbesar dalam bentuk kalimat (otomatis mengikuti hasil)\n",
    "t = top_err.iloc[0]\n",
    "arah = \"terlalu rendah\" if t['Selisih (Prediksi - Aktual)'] < 0 else \"terlalu tinggi\"\n",
    "print(f\"\\nContoh kesalahan: kamera '{t['Model Kamera']}' berharga aktual {t['Harga Aktual']:.0f} USD, \"\n",
    "      f\"tetapi diprediksi {t['Harga Prediksi']:.0f} USD ({arah}, selisih {abs(t['Selisih (Prediksi - Aktual)']):.0f} USD).\")\n",
    "\n",
    "# Pola kesalahan\n",
    "sq_err = analisis['Selisih (Prediksi - Aktual)'] ** 2\n",
    "mahal = analisis[analisis['Harga Aktual'] > 1000]\n",
    "murah = analisis[analisis['Harga Aktual'] <= 1000]\n",
    "print(f\"\\nKontribusi 10 kesalahan terbesar terhadap total kuadrat error: {sq_err.nlargest(10).sum() / sq_err.sum() * 100:.1f}%\")\n",
    "print(f\"Kamera dengan harga aktual <= 1000 USD: {len(murah)} kamera, rata-rata error absolut {murah['Error Absolut'].mean():.2f} USD\")\n",
    "if len(mahal) > 0:\n",
    "    print(f\"Kamera dengan harga aktual  > 1000 USD: {len(mahal)} kamera, rata-rata error absolut {mahal['Error Absolut'].mean():.2f} USD, \"\n",
    "          f\"rata-rata selisih {mahal['Selisih (Prediksi - Aktual)'].mean():.2f} USD (negatif = prediksi terlalu rendah)\")\n",
    "print(f\"Jumlah prediksi harga negatif: {(analisis['Harga Prediksi'] < 0).sum()}\")\n",
    "\n",
    "# Kesimpulan pola (otomatis mengikuti hasil)\n",
    "if len(mahal) > 0 and len(murah) > 0:\n",
    "    rasio = mahal['Error Absolut'].mean() / murah['Error Absolut'].mean()\n",
    "    arah_mahal = \"terlalu rendah\" if mahal['Selisih (Prediksi - Aktual)'].mean() < 0 else \"terlalu tinggi\"\n",
    "    print(f\"\\nPOLA: error rata-rata kamera mahal sekitar {rasio:.1f} kali error kamera murah, \"\n",
    "          f\"dan harga kamera mahal cenderung diprediksi {arah_mahal}.\")\n",
    "\n",
    "# Grafik pendukung: kesalahan terhadap harga aktual\n",
