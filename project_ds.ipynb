    "ax[0].plot(k_values, inertias, marker='o')\n",
    "ax[0].set_title('Elbow Method'); ax[0].set_xlabel('Jumlah cluster (k)'); ax[0].set_ylabel('Inertia')\n",
    "ax[1].plot(k_values, silhouettes, marker='o', color='green')\n",
