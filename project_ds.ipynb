    "from sklearn.dummy import DummyRegressor\n",
    "\n",
    "# Model yang dilatih. Nilai alpha Ridge & Lasso diambil dari hasil tuning (cross-validation) di atas.\n",
    "models = {\n",
    "    'Baseline (Mean)': DummyRegressor(strategy='mean'),   # pembanding: selalu menebak harga rata-rata\n",
    "    'Linear Regression': LinearRegression(),\n",
    "    'Ridge Regression': Ridge(alpha=best_alpha_ridge),\n",
    "    'Lasso Regression': Lasso(alpha=best_alpha_lasso, max_iter=10000)\n",
