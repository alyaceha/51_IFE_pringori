    "\n",
    "results = []\n",
    "trained_models = {}\n",
    "\n",
    "for name, model in models.items():\n",
    "    # Training: model belajar hanya dari data TRAIN yang sudah di-scaling\n",
    "    model.fit(X_train_scaled, y_train)\n",
    "\n",
    "    # Prediksi pada data TEST (data yang belum pernah dilihat model)\n",
    "    y_pred = model.predict(X_test_scaled)\n",
    "\n",
    "    # Evaluasi dengan metrik yang ditetapkan di Business Understanding\n",
    "    mae = mean_absolute_error(y_test, y_pred)\n",
    "    rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n",
    "    r2 = r2_score(y_test, y_pred)\n",
    "\n",
    "    results.append({\n",
    "        'Model': name,\n",
    "        'MAE': mae,\n",
    "        'RMSE': rmse,\n",
    "        'R2 Score': r2\n",
    "    })\n",
    "\n",
    "    trained_models[name] = model\n",
    "\n",
    "# Tabel perbandingan hasil semua model\n",
    "results_df = pd.DataFrame(results)\n",
    "results_df = results_df.sort_values(by='RMSE')\n",
    "\n",
    "display(results_df.round(4))"
