    "from sklearn.model_selection import GridSearchCV, KFold\n",
    "\n",
    "alpha_grid = {'alpha': [0.001, 0.01, 0.1, 1, 10, 100, 1000]}\n",
    "cv = KFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "tuning_rows = []\n",
    "best_params = {}\n",
    "for name, estimator in [('Ridge', Ridge()), ('Lasso', Lasso(max_iter=10000))]:\n",
    "    gs = GridSearchCV(estimator, alpha_grid, cv=cv, scoring='neg_root_mean_squared_error')\n",
    "    gs.fit(X_train_scaled, y_train)          # hanya data train\n",
    "    best_params[name] = gs.best_params_['alpha']\n",
    "    for a, score in zip(gs.cv_results_['param_alpha'], gs.cv_results_['mean_test_score']):\n",
    "        tuning_rows.append({'Model': name, 'alpha': a, 'CV RMSE': -score})\n",
    "\n",
    "tuning_df = pd.DataFrame(tuning_rows)\n",
    "display(tuning_df.pivot(index='alpha', columns='Model', values='CV RMSE').round(2))\n",
    "\n",
    "best_alpha_ridge = best_params['Ridge']\n",
    "best_alpha_lasso = best_params['Lasso']\n",
    "print(f\"Alpha terbaik Ridge: {best_alpha_ridge}\")\n",
    "print(f\"Alpha terbaik Lasso: {best_alpha_lasso}\")\n",
    "\n",
    "# Visualisasi pengaruh alpha terhadap RMSE cross-validation\n",
    "plt.figure(figsize=(8, 4))\n",
    "for name in ['Ridge', 'Lasso']:\n",
    "    sub = tuning_df[tuning_df['Model'] == name]\n",
    "    plt.plot(sub['alpha'].astype(float), sub['CV RMSE'], marker='o', label=name)\n",
    "plt.xscale('log')\n",
    "plt.xlabel('alpha (skala log)')\n",
    "plt.ylabel('RMSE Cross-Validation (USD)')\n",
    "plt.title('Pemilihan alpha dengan 5-Fold Cross-Validation')\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
