    "# Tabel perbandingan K-Means vs Hierarchical\n",
    "cluster_compare = pd.DataFrame({\n",
    "    'Algoritma': ['K-Means', 'Hierarchical (Ward)'],\n",
    "    'Jumlah Cluster': [k_opt, k_opt],\n",
    "    'Silhouette (lebih tinggi lebih baik)': [\n",
    "        silhouette_score(df_scaled_full, df['KMeans_Cluster']),\n",
    "        silhouette_score(df_scaled_full, df['HC_Cluster'])],\n",
    "    'Davies-Bouldin (lebih rendah lebih baik)': [\n",
    "        davies_bouldin_score(df_scaled_full, df['KMeans_Cluster']),\n",
    "        davies_bouldin_score(df_scaled_full, df['HC_Cluster'])],\n",
    "})\n",
    "display(cluster_compare.round(4))\n",
    "\n",
    "ari = adjusted_rand_score(df['KMeans_Cluster'], df['HC_Cluster'])\n",
    "print(f\"Kemiripan hasil K-Means vs Hierarchical (Adjusted Rand Index): {ari:.3f}  (1 = identik)\")\n",
    "\n",
    "# Profil segmen K-Means diurutkan dari harga rata-rata terendah ke tertinggi\n",
    "profile = df.groupby('KMeans_Cluster')[['Price', 'Weight (inc. batteries)', 'Effective pixels', 'Release date']].mean()\n",
    "profile['Jumlah Kamera'] = df['KMeans_Cluster'].value_counts()\n",
    "profile = profile.sort_values('Price')\n",
    "display(profile.round(2))"
   ]
