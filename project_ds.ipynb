    "plt.axhline(0, color='red', linestyle='--')\n",
    "plt.title('Selisih Prediksi terhadap Harga Aktual (Data Test)')\n",
    "plt.xlabel('Harga Aktual (USD)')\n",
    "plt.ylabel('Prediksi - Aktual (USD)')\n",
    "plt.tight_layout()\n",
    "plt.show()"
